# Zalo Bot Service Environment Variables
# Copy to .env and fill in your values

PORT=8787
NODE_ENV=development

# Channel mode: personal_zca | official_oa | mock
ZALO_CHANNEL_MODE=personal_zca

# --- Durable data location ---
# Dữ liệu bền vững (credentials Zalo, device-secret, DB chat, media, knowledge)
# mặc định lưu ở %LOCALAPPDATA%\AlphaCRM\zalo-bot-service (Windows) để KHÔNG mất
# khi cập nhật / di chuyển thư mục / chuyển giữa dev và bản đóng gói. Lần đầu chạy
# sẽ tự migrate từ .data cũ (nếu có). Bỏ trống để dùng mặc định; chỉ set nếu muốn
# ép sang thư mục khác.
# ALPHA_CRM_DATA_DIR=

# --- Personal Zalo (zca-js) ---
# Để TRỐNG các *_PATH bên dưới để lưu vào ALPHA_CRM_DATA_DIR (khuyến nghị).
# Chỉ set nếu muốn ép đường dẫn tuyệt đối/tương đối cụ thể.
# ZALO_PERSONAL_CREDENTIALS_PATH=
# ZALO_PERSONAL_QR_PATH=
ZALO_PERSONAL_ACCOUNT_LABEL=Personal Zalo 1
ZALO_PERSONAL_SELF_LISTEN=false

# --- Optional: Official OA (from https://developers.zalo.me) ---
ZALO_OA_ID=
ZALO_OA_SECRET=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=

# --- Optional: Official Bot API (zalo-bot-js-compatible transport) ---
# Used by official_oa mode for safe inbound/live-chat/chatbot text flows.
ZALO_BOT_TOKEN=
ZALO_BOT_API_BASE_URL=https://bot-api.zapps.me
ZALO_BOT_API_TIMEOUT_MS=12000

# Webhook verification token
ZALO_WEBHOOK_VERIFY_TOKEN=alpha-crm-verify

# Shared secret required on webhook requests. Send it as:
# x-zalo-webhook-secret: <value>
ZALO_WEBHOOK_SECRET=

# Comma-separated UID allowlist for /api/zalo/test-send.
# Keep empty in production unless explicit test users are approved.
ZALO_ALLOWED_TEST_UIDS=

# Server-side safety cap. Keep aligned with Alpha CRM Zalo compliance settings.
ZALO_MAX_BATCH_SIZE=20

# --- Production Agent and Cloud CRM Configuration ---
# Bind host for local Zalo HTTP service (127.0.0.1 for loopback security)
LOCAL_BIND_HOST=127.0.0.1
LOCAL_BIND_PORT=8787

# URL to Alpha Studio Cloud Backend
CRM_CLOUD_API_URL=https://alpha-studio-backend.fly.dev/api

# Path to store cloud-issued agent/device secret credentials.
# Để trống để lưu vào ALPHA_CRM_DATA_DIR (khuyến nghị — định danh máy bền vững).
# CRM_AGENT_SECRET_PATH=

# Enable outbound connection loop: enabled | disabled
CRM_AGENT_MODE=enabled

# --- Local-First Live Chat ---
# Set to true to store full messages locally and send only metadata to cloud
LOCAL_FIRST_LIVE_CHAT=true
# SQLite database path for local chat storage.
# Để trống để lưu vào ALPHA_CRM_DATA_DIR (khuyến nghị).
# LOCAL_CHAT_DB_PATH=
